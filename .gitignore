# =========================
# Root .gitignore
# =========================

# Ignore all node_modules
**/node_modules/

# Ignore environment files
**/.env

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Build folders
**/dist/
**/build/

# IDE files
.vscode/
.idea/

# OS files
.DS_Store
Thumbs.db

# Coverage
coverage/

# Misc
*.local